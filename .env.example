# Copy this file to .env and fill in the blanks. Never commit .env.
# Use only letters and numbers in passwords: they end up inside URLs.

# API keys (both free)
OPENAQ_API_KEY=
FIRMS_MAP_KEY=

# Warehouse. Port 5433 is the port on YOUR computer, chosen so it cannot
# collide with a PostgreSQL you may already have installed on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=airquality
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=ChangeMePipeline1

# Ports on YOUR computer for the web tools. Other projects here already use
# 3000, 5434, 5435, 8000 and 8080, so these are different. Change if taken.
AIRFLOW_PORT=8081
GRAFANA_PORT=3001

# Read-only login that Grafana uses
GRAFANA_DB_PASSWORD=ChangeMeGrafana1
GRAFANA_ADMIN_PASSWORD=ChangeMeAdmin1

# Any long random string
AIRFLOW_JWT_SECRET=ChangeMeToALongRandomString123456
